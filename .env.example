# Copy to .env and fill in. Never commit .env.

# Where the site lives. Used in email links. No trailing slash.
PUBLIC_URL=https://www.example.com
PORT=3000
NODE_ENV=production

# Admin panel at /admin
ADMIN_PASSWORD=change-me-to-a-long-password
# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# Email (any SMTP provider). Leave SMTP_HOST empty to save emails to data/outbox instead of sending.
#   Brevo:   smtp-relay.brevo.com, 587, user = your Brevo login, pass = SMTP key
#   Resend:  smtp.resend.com, 465, user = resend, pass = API key
#   Mailgun: smtp.mailgun.org, 587
#   Google Workspace: smtp.gmail.com, 465, app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AROLYZER <hello@example.com>"
MAIL_REPLY_TO=

# Newsletter speed. Keep it under your provider's limits (free plans usually cap emails per day).
SEND_PER_SECOND=2

# Database and outbox folder
DATA_DIR=./data

# Set to 1 when running behind Nginx, Caddy, Cloudflare or a load balancer, so rate limits see real visitor IPs
TRUST_PROXY=
