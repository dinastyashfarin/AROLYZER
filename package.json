{
  "name": "arolyzer-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n site,api -c green,blue \"vite\" \"node --watch server/index.js\"",
    "dev:site": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "check:content": "node scripts/check-content.js",
    "preview": "npm run build && npm start",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "marked": "^14.1.4",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.147.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
